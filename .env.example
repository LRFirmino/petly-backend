# Configuração do backend — copie este arquivo para ".env" na MESMA pasta (backend/).
#
# O Spring Boot está configurado para ler este .env automaticamente
# (spring.config.import=optional:file:./.env[.properties]).
# Regras: CHAVE=valor, uma por linha, SEM aspas e SEM espaços ao redor do "=".

# Banco: Turso (libSQL).
# Pegue a URL com:  turso db show <banco> --url    ->  libsql://<banco>-<org>.turso.io
# O driver também aceita: jdbc:dbeaver:libsql:https://<banco>.turso.io
TURSO_DATABASE_URL=libsql://<banco>-<org>.turso.io

# Token de acesso:  turso db tokens create <banco>
TURSO_AUTH_TOKEN=

# Opcional (autenticação é por token; normalmente fica vazio)
TURSO_DB_USER=

# Segredo do JWT (>= 256 bits). Gere um valor único por ambiente.
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-mais-de-32-caracteres

# Origens liberadas no CORS (separadas por vírgula).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Conta de administrador da plataforma (equipe/devs do SaaS).
# Se não definir, nenhuma conta de plataforma é criada.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
